# Supabase + Express Backend Environment Variables
# Copy these to your hosting platform (Render/Railway/Vercel)

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# JWT Secret (32+ characters)
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters-long

# Environment
NODE_ENV=production
PORT=5000

# CORS Origins (Frontend URLs)
FRONTEND_URL=https://wid-uganda-platform-4oh57u1g1-ptr234s-projects.vercel.app

# File Storage (Choose one: Supabase Storage or Cloudinary)
# Option 1: Supabase Storage (Recommended)
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=wid-uploads

# Option 2: Cloudinary (Alternative)
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
ENABLE_CORS=true
ENABLE_SUPABASE_FEATURES=true