# Railway Environment Variables Example
# Copy these to Railway Dashboard → Variables

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://username:password@hostname:port/database
POSTGRES_URL=postgresql://username:password@hostname:port/database

# JWT Secret (32+ characters)
JWT_SECRET=your-super-secure-jwt-secret-minimum-32-characters-long

# Environment
NODE_ENV=production
PORT=5000

# CORS Origins (Frontend URLs)
FRONTEND_URL=https://wid-uganda-platform-4oh57u1g1-ptr234s-projects.vercel.app

# Cloudinary (File Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
ENABLE_CORS=true